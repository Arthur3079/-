# ==============================================================
# Sonya — пример конфига. Скопируй этот файл в .env и заполни.
# Файл .env в .gitignore — секреты в репозиторий не попадут.
# ==============================================================

# --- Telegram userbot («Соня») ---
# Получить на https://my.telegram.org/apps
# Логинимся с номера, на котором будет жить аккаунт Сони.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Имя файла сессии (создаётся автоматически после первого логина)
TELEGRAM_SESSION_NAME=sonya

# --- Telegram payment bot («касса» для Stars) ---
# Создать у @BotFather, скопировать токен.
# Включить платежи Stars через @BotFather → Bot Settings → Payments.
# Если оставить PAY_BOT_TOKEN пустым — sales engine работает в DRY-режиме
# (логирует "would create invoice", без реальной оплаты), payment_bot
# процесс при старте корректно завершается с кодом 2.
PAY_BOT_TOKEN=
PAY_BOT_USERNAME=
# Currency — для Telegram Stars всегда XTR. Менять только если ставишь
# собственный provider_token у @BotFather.
PAY_CURRENCY=XTR

# --- Admin / operator ---
# CSV Telegram user ID, которым разрешено слать команды-`/команды` юзерботу
# (см. docs/runbook.md §5). Пусто → admin-чат не активирован.
ADMIN_USER_IDS=

# ============================================================
# LLM-провайдер
# ============================================================
# Какой бэкенд использовать:
#   openai_compat — OpenAI-совместимый endpoint (OpenRouter, NVIDIA NIM,
#                   Groq, DeepSeek, Together, Polza AI, OpenAI и др.).
#                   Рекомендую для OFM — есть uncensored-модели.
#   gemini        — Google Gemini через нативный SDK google-genai.
#                   Имеет жёсткий NSFW-фильтр; для интим-контента может
#                   не подойти. Хорош для общих чатов / GHOST recovery.
LLM_PROVIDER=openai_compat

# Общие параметры (применяются к ЛЮБОМУ бэкенду):
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.85
# Сколько последних сообщений с фаном подкладываем в контекст LLM.
LLM_HISTORY_LIMIT=12

# ------------------------------------------------------------
# Вариант A: openai_compat (default)
# ------------------------------------------------------------
# Бесплатные варианты ключей:
#   OpenRouter:    https://openrouter.ai/keys     (все модели через один ключ)
#   NVIDIA NIM:    https://build.nvidia.com       (5000 кредитов на старте)
#   Groq:          https://console.groq.com/keys  (быстро, ~1000/сутки free)
#   GitHub Models: https://github.com/marketplace/models   (низкие лимиты)
#
# Без ключа Соня шлёт заглушку [stub] received: <текст>.
LLM_API_KEY=
# Старое имя оставлено для бэк-совместимости.
# OPENROUTER_API_KEY=

# Endpoint провайдера. Дефолт — OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Примеры для других провайдеров (раскомментируй и поменяй ключ выше):
#   NVIDIA NIM:  LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com
#   Together:    LLM_BASE_URL=https://api.together.xyz/v1

# Модель. Дефолт — Hermes 3 Llama 405B (uncensored, бесплатно через OpenRouter).
# Хорошо подходит под OFM-флёрт: не режет интим-контент, держит характер персонажа.
LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
# Другие проверенные free-модели на OpenRouter:
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free       # общая, более «безопасная»
#   LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct:free        # Qwen 3 80B
#   LLM_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free  # uncensored
#   LLM_MODEL=z-ai/glm-4.5-air:free                        # GLM 4.5 (китайская)
#   LLM_MODEL=openai/gpt-oss-120b:free                     # OpenAI OSS 120B

# ------------------------------------------------------------
# Вариант B: gemini
# ------------------------------------------------------------
# Поставь LLM_PROVIDER=gemini выше + заполни ключ ниже.
# Получить ключ (бесплатно): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Модель. Доступные на момент написания:
#   gemini-3-flash-preview   — самая свежая, поддерживает thinking
#   gemini-2.5-flash         — стабильная, дешёвая
#   gemini-2.5-pro           — мощнее, медленнее
GEMINI_MODEL=gemini-3-flash-preview
# Уровень «размышлений» (thinking): HIGH / MEDIUM / LOW / пусто (выкл).
# HIGH ощутимо замедляет ответ — для OFM-чата обычно не нужен.
GEMINI_THINKING_LEVEL=

# --- БД ---
# Локально: sqlite. На сервере поменять на postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./sonya.db

# --- Логи ---
# LOG_LEVEL=DEBUG включает дамп каждого LLM-обмена в logs/prompts/<timestamp>.md
# (system prompt + история + ответ + токены + latency). Удобно чтобы понять
# что именно «видит» Соня и почему она ответила так.
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Combine (multi-account, GramGPT-clone) ---
# Fernet key (32 url-safe base64 bytes) used to encrypt:
#   * combine_accounts.session_blob (Telethon StringSession)
#   * combine_proxies.password
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty value disables encryption (data stored as-is). DO NOT leave empty in production.
COMBINE_SECRET_KEY=

# --- Поведение ---
# Базовый язык переписки (en / ru). Подстраивается под фана автоматически.
DEFAULT_LANGUAGE=en
# Часовой пояс «жизни Сони» (Барселона / Сочи)
SONYA_TIMEZONE=Europe/Madrid
# Включить «человеческие» паузы и онлайн-режим
ENABLE_HUMANIZER=true
# Dry-run: всё логируем и сохраняем в БД, но НЕ отправляем сообщения в Telegram.
# Дефолт — true (безопасный). Поставь false когда готов реально отвечать фанам.
DRY_RUN=true

# --- Runtime safety / orchestration ---
# Сколько секунд ждать «тишины» от фана перед ответом (схлопывает «hi», "you there?", "?" в один ответ).
INCOMING_DEBOUNCE_SECONDS=3.0
# Если Telegram пришлёт FloodWait дольше этого — пропустим отправку, не зависая.
TELEGRAM_MAX_FLOOD_WAIT_SECONDS=120

# --- Knowledge retrieval ---
# Сколько чанков из knowledge/ максимум пихать в system prompt.
KNOWLEDGE_MAX_SNIPPETS=4
# Cumulative cap на длину выбранных снипетов (символы).
KNOWLEDGE_MAX_CHARS=1800

# --- Dialogue / humanizer ---
# На сколько «бабблов» резать длинный ответ LLM. 1 = никогда не резать.
MAX_REPLY_BUBBLES=2
# Пауза между бабблами (секунды). Помимо typing-задержки.
INTER_BUBBLE_DELAY_SECONDS=0.6
